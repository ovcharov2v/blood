extends pug/base

prepend styles
	link(rel="stylesheet" href=`./lib/swiper/swiper-bundle.css`)
prepend scripts
	script(src=`./lib/swiper/swiper-bundle.min.js`)

block content
	+breadcrumb(["Главная"], "Учреждение службы крови", "Часто задаваемые вопросы")
	// Section HowTo
	.section-faq.container
		h1.section-faq__title.h1 Часто задаваемые вопросы
		.section-faq__filter
			.select
				.select__current-box
					input.select__input(type="hidden", value="")
					p.select__current.select__current--placeholder Код донации
					+svg("chevron-down").select__drop-icon
				ul.select__list
					li.select__list-item Код донации 1
					li.select__list-item Код донации 2
					li.select__list-item Код донации 3
			.form-group
				.form-group__input-box
					input.input.form-group__input(
						type="text"
						placeholder="Поиск по названию"
					)
					button.form-group__btn(type="button", aria-label="Искать")
						+svg("search").form-group__btn-icon
		h2.section-faq__subtitle.h2 Код донации
		.section-faq__grid
			- let i = 0
			while i < 11
				// item
				.section-faq__item
					.section-faq__item-question
						.section-faq__item-question-wrap
							p.section-faq__item-title Вопрос:
							p.section-faq__item-question-text Где я могу получить код донации и что он дает?
						button.section-faq__item-btn(aria-label="Показать")
							+svg("chevron-down").section-faq__item-btn-icon
					.section-faq__item-answer
						p.section-faq__item-title Ответ:
						.section-faq__item-answer-text
							p Служба крови отвечает:
								br
								|Код донации - это уникальный 20-значный код, который формируется автоматизированной информационной системой трансфузиологии и содержащий в себе информацию о Вашей донации, отображенной в информационной базе.
				- i++

	+sectionNews(true)