extends pug/base

prepend styles
	link(rel="stylesheet" href=`./lib/swiper/swiper-bundle.css`)
prepend scripts
	script(src=`./lib/swiper/swiper-bundle.min.js`)

block content
	+breadcrumb(["Главная", "Новости"], "Прием заявок на Всероссийский конкурс профессионального мастерства продлен до 10 ноября")
	// Section article
	.section-article.container
		h1.section-article__title Прием заявок на Всероссийский конкурс профессионального мастерства продлен до 10 ноября
		.section-article__info
			time.section-article__date 29 апреля 2025 г.
			a.section-article__tag.tag(href="#") Федеральная новость
		figure.section-article__intro
			.section-article__intro-img-box
				img.section-article__intro-img(src="./images/article/img.jpg", alt="")
			figcaption.section-article__intro-text «Для нас крайне важны системные партнерства с большими компаниями. Мы постоянно развиваем систему корпоративного донорства. Вместе с X5 мы создаем экосистему взаимопомощи, где бизнес активно включается в социально значимую повестку» — прокомментировала Ольга Эйхлер, начальник Управления Службы крови и экстремальной медицины ФМБА России.
		.section-article__grid
			.section-article__content
				p Конкурс проходит ежегодно и направлен на поощрение лучших практик, достижений и инициатив в сфере донорства. Участие в конкурсе — это возможность представить свои проекты на федеральном уровне, получить признание профессионального сообщества, обменяться опытом и внести вклад в развитие донорского движения в России.

				p В 2025 году, посвященном защитникам Отечества, организаторы конкурса отмечают: каждый донор и специалист Службы крови — это защитник жизни. Их усилия — не просто работа, а вклад в безопасность страны, здоровье ее граждан и будущее поколений.
					br
					|Подведение итогов конкурса, определение и награждение победителей состоится в рамках проведения XVII Всероссийского форума Службы крови 26 ноября в Национальном центре «Россия» в Москве.

				p Конкурс проходит ежегодно и направлен на поощрение лучших практик, достижений и инициатив в сфере донорства. Участие в конкурсе — это возможность представить свои проекты на федеральном уровне, получить признание профессионального сообщества, обменяться опытом и внести вклад в развитие донорского движения в России.

				p В 2025 году, посвященном защитникам Отечества, организаторы конкурса отмечают: каждый донор и специалист Службы крови — это защитник жизни. Их усилия — не просто работа, а вклад в безопасность страны, здоровье ее граждан и будущее поколений.
					br
					|Подведение итогов конкурса, определение и награждение победителей состоится в рамках проведения XVII Всероссийского форума Службы крови 26 ноября в Национальном центре «Россия» в Москве.

				blockquote «Для нас крайне важны системные партнерства с большими компаниями. Мы постоянно развиваем систему корпоративного донорства. Вместе с X5 мы создаем экосистему взаимопомощи, где бизнес активно включается в социально значимую повестку» — прокомментировала Ольга Эйхлер, начальник Управления Службы крови и экстремальной медицины ФМБА России.

				.section-article__how-to
					p
						strong Как подать заявку:
						br
						|Для участия необходимо подать заявку на сайте 
						a(href="mailto:forum2025.yadonor.ru") forum2025.yadonor.ru.
						br
						|В состав заявки должен входить заполненный шаблон презентации в соответствии с заявленной номинацией.

				.section-article__bottom
					a.section-article__source-link(href="#") Источник новости и фото: ФМБА России (Москва)
					ul.section-article__tag-list
						li.section-article__tag-el
							a.tag.section-article__tag-link(href="#") Федеральная новость
						li.section-article__tag-el
							a.tag.section-article__tag-link(href="#") ФМБА России
						li.section-article__tag-el
							a.tag.section-article__tag-link(href="#") Акция
						li.section-article__tag-el
							a.tag.section-article__tag-link(href="#") Анонс
						li.section-article__tag-el
							a.tag.section-article__tag-link(href="#") Партнеры Программы развития добровольного донорства крови
					.section-article__share-box
						p.section-article__share-title Поделиться:
						.section-article__share-list
							img(src="./images/article/share-vk.png", alt="")
							img(src="./images/article/share-ok.png", alt="")
							img(src="./images/article/share-telegram.png", alt="")
			// col
			.section-article__news-col
				.section-article__news-col-group
					h3.section-article__news-title Рекомендуем:
					.section-article__news-card-box
						// card
						.section-article__news-card
							p.section-article__news-card-title Организуйте донорскую акцию в компании
							a.button.button--round-corner.button--outline-white.section-article__news-card-link(href="#") Подать заявку
						// card
						.section-article__news-card
							p.section-article__news-card-title Присоединяйтесь к волонтерам Службы крови
							a.button.button--round-corner.button--outline-white.section-article__news-card-link(href="#") Как стать волонтером?
				.section-article__news-col-group
					h3.section-article__news-title Наши события:
					.swiper.section-article__news-slider
						.swiper-wrapper
							- let i = 0
							while i < 5
								// slide
								.swiper-slide
									a.article-news(href="#")
										.article-news__info-box
											.article-news__date
												+svg("calendar").article-news__date-icon
												time.article-news__date-value 25 апреля
											.article-news__place
												+svg("map-pin").article-news__place-icon
												span.article-news__place-value Москва
										p.article-news__title Волонтерская помощь при работе с гражданами на донорских пунктах города москва
										p.article-news__description В рамках проекта донорские акции МРО ВОП «Волонтеры-медики»
										.article-news__img-box
											img.article-news__img(src="./images/article/article-news.png", alt="")
								- i++
					.section-article__news-dots.slider-dots.slider-dots--color

	+sectionNews(false)